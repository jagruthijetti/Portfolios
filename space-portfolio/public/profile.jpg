<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B1635" />
      <stop offset="50%" stop-color="#30105C" />
      <stop offset="100%" stop-color="#050B18" />
    </linearGradient>
    <linearGradient id="avatarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#39C6FF" />
      <stop offset="50%" stop-color="#9B5CFF" />
      <stop offset="100%" stop-color="#FF4FD8" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  
  <rect width="400" height="400" fill="url(#bgGrad)" />
  
  <!-- Stars -->
  <circle cx="60" cy="80" r="2" fill="#FFF" opacity="0.8"/>
  <circle cx="320" cy="50" r="1.5" fill="#39C6FF" opacity="0.9"/>
  <circle cx="340" cy="310" r="2" fill="#FF4FD8" opacity="0.7"/>
  <circle cx="80" cy="330" r="1" fill="#FFF" opacity="0.6"/>
  
  <!-- Halo Ring -->
  <circle cx="200" cy="200" r="140" fill="none" stroke="url(#avatarGrad)" stroke-width="4" filter="url(#glow)" opacity="0.8" />
  <circle cx="200" cy="200" r="125" fill="#050B18" stroke="#39C6FF" stroke-width="2" opacity="0.9"/>
  
  <!-- Developer Avatar Silhouette -->
  <g transform="translate(100, 80)">
    <!-- Head -->
    <circle cx="100" cy="80" r="48" fill="url(#avatarGrad)" />
    <!-- Shoulders -->
    <path d="M 20 200 C 20 140, 180 140, 180 200 Z" fill="url(#avatarGrad)" opacity="0.9"/>
  </g>
  
  <!-- Hologram details -->
  <text x="200" y="360" font-family="sans-serif" font-size="18" font-weight="bold" fill="#39C6FF" text-anchor="middle" letter-spacing="3">JAGRUTHI JETTI</text>
</svg>
